# =====================================================================
#  config.ps1 - 配置文件
#
#  用法：把本文件复制一份，改名成 config.ps1，然后按自己的情况改路径。
#  升级脚本只更新 start.ps1 / doctor.ps1，永远不碰 config.ps1。
#
#  改完直接保存即可，不用管编码（记事本存 UTF-8 就行）。
# =====================================================================

# ---------------------------------------------------------------------
#  1. 模型目录 —— 放 .gguf 的地方，会递归扫描子目录
# ---------------------------------------------------------------------
$MODELS_DIR = "D:\models"

# ---------------------------------------------------------------------
#  2. llama.cpp 目录
#
#     期望结构（每个构建一个子目录）：
#         D:\models\llama-b11514\llama-server.exe
#         D:\models\llama-b11537\llama-server.exe
#
#     启动器自动挑构建号最大的那个，所以升级只要解压新目录进来，
#     不用改配置；旧目录留着还能回退。
# ---------------------------------------------------------------------
$LLAMA_DIR = "D:\models"

#  （可选）手动指定 exe 完整路径，留空 = 自动挑最新
# $LLAMA_EXE = "D:\models\llama-b11514\llama-server.exe"

# ---------------------------------------------------------------------
#  3. 监听地址和端口
#    本地自用 127.0.0.1 就够；要给别的机器用才改 0.0.0.0
#    注意：0.0.0.0 等于对全网开放，除非有防火墙挡着
# ---------------------------------------------------------------------
$LISTEN_HOST = "127.0.0.1"
$PORT = 1234

# ---------------------------------------------------------------------
#  4. 默认上下文长度
#     留空 = 按模型自动判断（启动器内置各架构建议值）
#     填数字 = 强制用这个值，比如 32768
# ---------------------------------------------------------------------
$CTX_OVERRIDE = $null

# ---------------------------------------------------------------------
#  5. KV cache 量化
#     留空 = 自动（ctx >= 64K 用 q4_0，否则 q8_0）
#     也可填 "q8_0" 或 "q4_0"
#     显存吃紧填 q4_0
# ---------------------------------------------------------------------
$KV_CACHE_TYPE = $null

# ---------------------------------------------------------------------
#  6. 是否默认开思考
#     "on" / "off" / 留空 = 按模型默认
# ---------------------------------------------------------------------
$REASONING_OVERRIDE = $null

# ---------------------------------------------------------------------
#  7. API 密钥（可选）
#     填了客户端就必须带 Authorization: Bearer <key>
#     本地自用留空
# ---------------------------------------------------------------------
$API_KEY = $null

# ---------------------------------------------------------------------
#  8. 最低 llama.cpp 构建号（只有 Spark-X2.5 走这个自检）
#     低于此版本不认 spark2_5 架构，启动报 unknown architecture
# ---------------------------------------------------------------------
$MIN_BUILD = 10828

# ---------------------------------------------------------------------
#  9. 远程模式（进阶，见 docs/remote-mode.md）
#     Tailscale 主机名，留空 = 不用远程模式
# ---------------------------------------------------------------------
$TAILNET_HOST = $null
